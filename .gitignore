# ============================================================
#  P.H.M. — Phira Huamei Metric
#  数据与外部素材不入库（体积大、可重新获取）
# ============================================================

# ── 数据 ──
# 保留三份「真源」（体积小、是运行工具的必需输入，开源后他人可直接出报告）：
#   data/official.jsonl   1.7MB  官谱 1,037 条
#   data/community.jsonl   18MB  社区谱 9,684 条
# 排除超大原始语料（31GB）与可由流水线重建的中间产物：
data/charts/
data/.stages/
data/_backup_before_consolidate/

# ── 外部素材（Phira 源码、竞品工具、APK 等）──
_research/
第三方参考/
*.apk

# ── 构建产物（由 build_standalone.py 生成）──
phm/P.H.M..html
phm/gui/data/

# ── 批量报告（由 cli.py --batch 生成）──
reports/

# ── 工具本地状态（工作日志等，不入开源仓库）──
.workbuddy/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── Node ──
node_modules/
package-lock.json

# ── 编辑器 / 系统 ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 临时文件 ──
*.tmp
_check.js
*.log

# ── 本地归档与测试数据（不入库）──
_archive/
谱面数据包/

# ── WorkBuddy sites 本地绑定文件 ──
.wbapp_*.genie
