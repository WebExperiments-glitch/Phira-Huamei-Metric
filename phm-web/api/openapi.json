          "charts"
        ],
        "operationId": "getChart",
        "summary": "Read a cached chart",
        "security": [
          {},
          {
            "phmKey": []
          },
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "x-scopes": [
          "charts:read"
        ],
        "parameters": [
          {
            "name": "chart_id",
