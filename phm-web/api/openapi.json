    "/keys": {
      "get": {
        "tags": [
          "keys"
        ],
        "operationId": "listKeys",
        "summary": "List active API keys",
        "security": [],
        "x-auth": "account-token",
        "x-scopes": [],
        "responses": {
          "200": {
            "description": "Active keys"
          }
        }
      },
      "post": {
        "tags": [
          "keys"
        ],
        "operationId": "createKey",
        "summary": "Create an API key",
        "security": [],
        "x-auth": "account-token",
        "x-scopes": [],
        "requestBody": {
          "required": true,
          "content": {
