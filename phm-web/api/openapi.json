{
  "openapi": "3.1.0",
  "info": {
    "title": "P.H.M. API",
    "version": "1.0.0",
    "description": "Phira / Phigros chart difficulty reference API. Free; anonymous and API-key access."
  },
  "servers": [
    {
      "url": "https://phm.app.workbuddy.host/api/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "meta"
    },
    {
      "name": "charts"
    },
    {
      "name": "keys"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "sk-...",
        "description": "API key. Scopes: charts:read, analyses:write, usage:read. 兼容保留；部署环境的网关会注入自己的 Authorization 头，可能让 Key 静默降级为匿名 —— 优先用 x-api-key。"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key（推荐）。sk- 加 32 位十六进制。自定义头不会被网关改写，能稳定以 Key 身份计限额。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "code",
              "message"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "api": {
            "type": "string"
          },
          "service": {
            "type": [
              "string",
              "null"
            ]
          },
          "engine": {
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Chart": {
        "type": "object",
        "properties": {
          "chart_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "difficulty": {
            "type": [
              "number",
              "null"
            ]
          },
          "ref_const": {
            "type": [
              "number",
              "null"
            ]
          },
          "ref_official": {
            "type": [
              "number",
              "null"
            ]
          },
          "ps_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "analyzed": {
            "type": "boolean"
          },
          "cached": {
            "type": "boolean"
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "today": {
            "type": "integer"
          },
          "week": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          },
          "keys": {
            "type": "integer"
          },
          "by_endpoint": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "key_usage": {
            "type": [
              "object",
              "null"
            ]
          },
          "quota": {
            "type": "object"
          }
        }
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ApiKeyCreated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiKey"
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  },
  "paths": {
    "/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "getMeta",
        "summary": "Service build metadata",
        "security": [],
        "responses": {
          "200": {
            "description": "API service versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            }
          }
        }
      }
    },
    "/charts/{chart_id}": {
      "get": {
        "tags": [
          "charts"
        ],
        "operationId": "getChart",
        "summary": "Read a cached chart",
        "security": [
          {},
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "x-scopes": [
          "charts:read"
        ],
        "parameters": [
          {
            "name": "chart_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chart or analyzed:false",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chart"
                }
              }
            }
          },
          "401": {
            "description": "Invalid key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/analyses": {
      "post": {
        "tags": [
          "charts"
        ],
        "operationId": "createAnalysis",
        "summary": "Analyse a chart and cache the result",
        "security": [
          {},
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "x-scopes": [
          "analyses:write"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "chart_id"
                ],
                "properties": {
                  "chart_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chart"
                }
              }
            }
          },
          "401": {
            "description": "Invalid key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/usage": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "getUsage",
        "summary": "Usage for the current key or account",
        "security": [
          {
            "bearer": []
          },
          {
            "apiKey": []
          }
        ],
        "x-scopes": [
          "usage:read"
        ],
        "responses": {
          "200": {
            "description": "Usage summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "401": {
            "description": "Invalid key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/keys": {
      "get": {
        "tags": [
          "keys"
        ],
        "operationId": "listKeys",
        "summary": "List active API keys",
        "security": [],
        "x-auth": "account-token",
        "x-scopes": [],
        "responses": {
          "200": {
            "description": "Active keys"
          }
        }
      },
      "post": {
        "tags": [
          "keys"
        ],
        "operationId": "createKey",
        "summary": "Create an API key",
        "security": [],
        "x-auth": "account-token",
        "x-scopes": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "expires_in_days": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; plaintext once",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyCreated"
                }
              }
            }
          }
        }
      }
    },
    "/keys/{id}": {
      "patch": {
        "tags": [
          "keys"
        ],
        "operationId": "updateKey",
        "summary": "Rename, change scopes or expiry",
        "security": [],
        "x-auth": "account-token",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "expires_in_days": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "keys"
        ],
        "operationId": "revokeKey",
        "summary": "Revoke a key",
        "security": [],
        "x-auth": "account-token",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/keys/{id}/rotate": {
      "post": {
        "tags": [
          "keys"
        ],
        "operationId": "rotateKey",
        "summary": "Create a replacement key and revoke the old one",
        "security": [],
        "x-auth": "account-token",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "New key (plaintext once)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyCreated"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}
